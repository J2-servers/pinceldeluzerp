{
  "name": "StockAdjustment",
  "type": "object",
  "properties": {
    "adjustment_number": {
      "type": "string",
      "description": "N\u00famero do ajuste"
    },
    "warehouse_id": {
      "type": "string",
      "description": "Dep\u00f3sito"
    },
    "location_id": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o"
    },
    "reason": {
      "type": "string",
      "description": "Motivo obrigat\u00f3rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "posted",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "adjustment_number",
    "warehouse_id",
    "reason"
  ]
}