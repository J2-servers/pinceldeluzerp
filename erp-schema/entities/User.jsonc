{
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do usuario"
    },
    "email": {
      "type": "string",
      "description": "E-mail de login (unico)"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash PBKDF2 da senha (gerado pelo servidor, nunca em texto puro)"
    },
    "role": {
      "type": "string",
      "description": "Perfil de acesso do usuario",
      "enum": [
        "admin",
        "gestor",
        "comercial",
        "financeiro",
        "operacao",
        "leitura"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Usuario ativo (pode logar)"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "Exige troca de senha no proximo login"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do ultimo login"
    }
  },
  "required": [
    "name",
    "email",
    "password_hash",
    "role"
  ],
  "name": "User",
  "type": "object"
}
