{
  "name": "SalesOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto principal"
    },
    "product_group": {
      "type": "string",
      "description": "Grupo do produto"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "unitario",
        "area_m2",
        "comprimento",
        "peso",
        "hora",
        "manual"
      ],
      "description": "Modo de precifica\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade total vendida"
    },
    "unit_price": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio aplicado"
    },
    "width_mm": {
      "type": "number",
      "description": "Largura em mm"
    },
    "height_mm": {
      "type": "number",
      "description": "Altura em mm"
    },
    "items": {
      "type": "string",
      "description": "Itens/servi\u00e7os"
    },
    "line_items_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal"
    },
    "discount_percent": {
      "type": "number",
      "default": 0,
      "description": "Desconto percentual"
    },
    "labor_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas de m\u00e3o de obra"
    },
    "labor_cost_hour": {
      "type": "number",
      "default": 0,
      "description": "Custo da m\u00e3o de obra por hora"
    },
    "labor_cost_total": {
      "type": "number",
      "default": 0,
      "description": "Custo total de m\u00e3o de obra"
    },
    "machine_time_min": {
      "type": "number",
      "default": 0,
      "description": "Minutos de m\u00e1quina"
    },
    "machine_cost_per_min": {
      "type": "number",
      "default": 0,
      "description": "Custo por minuto de m\u00e1quina"
    },
    "machine_cost_total": {
      "type": "number",
      "default": 0,
      "description": "Custo total de m\u00e1quina"
    },
    "general_art_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo geral de arte"
    },
    "additional_charge": {
      "type": "number",
      "default": 0,
      "description": "Acr\u00e9scimo geral"
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo total do pedido"
    },
    "total": {
      "type": "number",
      "description": "Total"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "parcelado",
        "boleto",
        "crediario"
      ],
      "description": "Forma de pagamento"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Data de entrega"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "em_producao",
        "pronto",
        "entregue",
        "cancelado"
      ],
      "default": "novo",
      "description": "Status do pedido"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcial",
        "pago"
      ],
      "default": "pendente",
      "description": "Status de pagamento"
    },
    "transaction_id": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o vinculada"
    }
  },
  "required": [
    "client_name",
    "items",
    "total"
  ]
}