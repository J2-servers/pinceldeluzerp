{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade"
    },
    "reason": {
      "type": "string",
      "description": "Motivo"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data"
    }
  },
  "required": [
    "product_id",
    "type",
    "quantity"
  ]
}