{
  "name": "LaserTube",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome/Identifica\u00e7\u00e3o"
    },
    "machine": {
      "type": "string",
      "description": "M\u00e1quina"
    },
    "current_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas atuais"
    },
    "max_hours": {
      "type": "number",
      "description": "Horas m\u00e1ximas"
    },
    "power_loss": {
      "type": "number",
      "default": 0,
      "description": "Perda de pot\u00eancia (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "substituir"
      ],
      "default": "ativo",
      "description": "Status"
    },
    "cost": {
      "type": "number",
      "description": "Custo do tubo"
    },
    "install_date": {
      "type": "string",
      "format": "date",
      "description": "Data de instala\u00e7\u00e3o"
    }
  },
  "required": [
    "name",
    "max_hours"
  ]
}