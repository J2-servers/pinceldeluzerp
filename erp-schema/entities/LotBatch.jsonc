{
  "name": "LotBatch",
  "type": "object",
  "properties": {
    "product_variant_id": {
      "type": "string",
      "description": "Variante"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do lote"
    },
    "supplier_lot": {
      "type": "string",
      "description": "Lote do fornecedor"
    },
    "manufacture_date": {
      "type": "string",
      "format": "date",
      "description": "Fabrica\u00e7\u00e3o"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Validade"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "consumed",
        "expired"
      ],
      "default": "active",
      "description": "Status"
    }
  },
  "required": [
    "product_variant_id",
    "code"
  ]
}