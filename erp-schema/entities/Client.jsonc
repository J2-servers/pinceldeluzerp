{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ (somente d\u00edgitos, 11 ou 14)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "parcelado",
        "boleto",
        "crediario",
        "transferencia"
      ],
      "description": "Forma de pagamento preferida"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_dia",
        "atrasado",
        "inadimplente"
      ],
      "default": "em_dia",
      "description": "Status do cliente"
    },
    "total_purchases": {
      "type": "number",
      "default": 0,
      "description": "Total de compras"
    },
    "total_debt": {
      "type": "number",
      "default": 0,
      "description": "D\u00edvida total"
    },
    "credit_limit": {
      "type": "number",
      "default": 0,
      "description": "Limite de cr\u00e9dito em reais (0 = sem limite definido)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "name"
  ]
}