{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo da transa\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "vendas",
        "servicos",
        "aluguel",
        "salarios",
        "fornecedores",
        "impostos",
        "manutencao",
        "materiais",
        "outros"
      ],
      "description": "Categoria"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "parcelado",
        "boleto",
        "crediario",
        "transferencia"
      ],
      "description": "Forma de pagamento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da transa\u00e7\u00e3o"
    },
    "partner": {
      "type": "string",
      "enum": [
        "Maeli",
        "Wesley",
        "Juliano"
      ],
      "description": "S\u00f3cio respons\u00e1vel"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "order_id": {
      "type": "string",
      "description": "ID do pedido vinculado"
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Transa\u00e7\u00e3o confirmada"
    }
  },
  "required": [
    "type",
    "amount",
    "date"
  ]
}