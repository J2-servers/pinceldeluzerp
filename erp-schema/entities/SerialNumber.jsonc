{
  "name": "SerialNumber",
  "type": "object",
  "properties": {
    "product_variant_id": {
      "type": "string",
      "description": "Variante"
    },
    "serial": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "warehouse_id": {
      "type": "string",
      "description": "Dep\u00f3sito"
    },
    "location_id": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "sold",
        "returned",
        "blocked"
      ],
      "default": "available",
      "description": "Status"
    }
  },
  "required": [
    "product_variant_id",
    "serial"
  ]
}