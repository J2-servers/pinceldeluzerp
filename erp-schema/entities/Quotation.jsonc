{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "quotation_number": {
      "type": "string",
      "description": "N\u00famero do or\u00e7amento"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "price_list_id": {
      "type": "string",
      "description": "Tabela de pre\u00e7o"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "draft",
      "description": "Status"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Validade"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Desconto"
    },
    "total": {
      "type": "number",
      "description": "Total"
    },
    "origin": {
      "type": "string",
      "description": "Origem comercial"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "quotation_number",
    "customer_name"
  ]
}