        "devolucao_emprestimo"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "transferencia",
