{
  "name": "AccountReceivable",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor"
    },
    "amount_received": {
      "type": "number",
      "description": "Valor recebido"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "competence_date": {
      "type": "string",
      "format": "date",
      "description": "Data de compet\u00eancia"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "order_id": {
      "type": "string",
      "description": "ID do pedido"
    },
    "category": {
      "type": "string",
      "enum": [
        "vendas",
        "servicos",
        "aluguel",
        "comissao",
        "outros"
      ],
      "description": "Categoria"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "boleto",
        "transferencia",
        "crediario"
      ],
      "description": "Forma de recebimento"
    },
    "installments": {
      "type": "number",
      "default": 1,
      "description": "Parcelas"
    },
    "installment_number": {
      "type": "number",
      "default": 1,
      "description": "Parcela n\u00ba"
    },
    "received": {
      "type": "boolean",
      "default": false,
      "description": "Recebido"
    },
    "received_date": {
      "type": "string",
      "format": "date",
      "description": "Data do recebimento"
    },
    "received_by_partner": {
      "type": "string",
      "enum": [
        "Maeli",
        "Wesley",
        "Juliano"
      ],
      "description": "Recebido por qual s\u00f3cio"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "description",
    "amount",
    "due_date"
  ]
}