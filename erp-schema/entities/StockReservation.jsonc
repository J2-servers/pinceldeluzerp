{
  "name": "StockReservation",
  "type": "object",
  "properties": {
    "product_variant_id": {
      "type": "string",
      "description": "Variante"
    },
    "warehouse_id": {
      "type": "string",
      "description": "Dep\u00f3sito"
    },
    "location_id": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o"
    },
    "reference_type": {
      "type": "string",
      "description": "Tipo da refer\u00eancia"
    },
    "reference_id": {
      "type": "string",
      "description": "Documento de origem"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade reservada"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "released",
        "consumed",
        "expired"
      ],
      "default": "active",
      "description": "Status"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expira em"
    }
  },
  "required": [
    "product_variant_id",
    "warehouse_id",
    "quantity",
    "status"
  ]
}