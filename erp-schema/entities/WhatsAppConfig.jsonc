{
  "name": "WhatsAppConfig",
  "type": "object",
  "properties": {
    "api_url": {
      "type": "string",
      "description": "URL da API Evolution"
    },
    "api_key": {
      "type": "string",
      "description": "API Key"
    },
    "instance_name": {
      "type": "string",
      "description": "Nome da inst\u00e2ncia"
    },
    "connected": {
      "type": "boolean",
      "default": false,
      "description": "Conectado"
    },
    "last_check": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima verifica\u00e7\u00e3o"
    }
  },
  "required": [
    "api_url",
    "instance_name"
  ]
}