{
  "name": "ProductAlternative",
  "type": "object",
  "properties": {
    "product_variant_id": {
      "type": "string",
      "description": "Variante de origem"
    },
    "alternative_variant_id": {
      "type": "string",
      "description": "Variante alternativa"
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "substitute",
        "equivalent",
        "cross_sell"
      ],
      "default": "substitute",
      "description": "Tipo de rela\u00e7\u00e3o"
    },
    "priority": {
      "type": "number",
      "description": "Prioridade"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Ativa"
    }
  },
  "required": [
    "product_variant_id",
    "alternative_variant_id"
  ]
}