{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o"
    },
    "category": {
      "type": "string",
      "enum": [
        "acrilico",
        "mdf",
        "metais",
        "eletronicos",
        "quimicos",
        "ferramentas",
        "embalagens",
        "tintas",
        "gases",
        "manutencao",
        "outros"
      ],
      "description": "Categoria"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 3,
      "description": "Avalia\u00e7\u00e3o (1-5)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "company_name"
  ]
}