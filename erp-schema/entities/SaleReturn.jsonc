{
  "name": "SaleReturn",
  "type": "object",
  "properties": {
    "return_number": {
      "type": "string",
      "description": "N\u00famero da devolu\u00e7\u00e3o"
    },
    "sales_order_id": {
      "type": "string",
      "description": "Pedido relacionado"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "received",
        "closed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status"
    },
    "total": {
      "type": "number",
      "description": "Total"
    },
    "reason": {
      "type": "string",
      "description": "Motivo"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Data"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "return_number",
    "customer_name"
  ]
}