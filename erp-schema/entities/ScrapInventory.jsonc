{
  "name": "ScrapInventory",
  "type": "object",
  "properties": {
    "material": {
      "type": "string",
      "description": "Material"
    },
    "width": {
      "type": "number",
      "description": "Largura (mm)"
    },
    "height": {
      "type": "number",
      "description": "Altura (mm)"
    },
    "thickness": {
      "type": "number",
      "description": "Espessura (mm)"
    },
    "area": {
      "type": "number",
      "description": "\u00c1rea (m\u00b2)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponivel",
        "reservado",
        "utilizado"
      ],
      "default": "disponivel",
      "description": "Status"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o"
    },
    "product_id": {
      "type": "string",
      "description": "Produto area_m2 vinculado (opcional). Usado para baixar a area do saldo ao descartar como sucata."
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o retalho foi marcado como utilizado"
    },
    "discarded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o retalho foi descartado como sucata (perda real)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o retalho"
    }
  },
  "required": [
    "material",
    "width",
    "height"
  ]
}