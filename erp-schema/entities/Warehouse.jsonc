{
  "name": "Warehouse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do dep\u00f3sito"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do dep\u00f3sito"
    },
    "type": {
      "type": "string",
      "enum": [
        "principal",
        "loja",
        "transito",
        "devolucao",
        "perda"
      ],
      "default": "principal",
      "description": "Tipo do dep\u00f3sito"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Ativo"
    }
  },
  "required": [
    "name",
    "code"
  ]
}