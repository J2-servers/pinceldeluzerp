{
  "name": "OperationalLoss",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da perda"
    },
    "loss_percent": {
      "type": "number",
      "description": "Percentual de perda"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "orcamentos",
        "producao",
        "materiais",
        "geral"
      ],
      "description": "Onde a perda \u00e9 aplicada"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Ativo"
    }
  },
  "required": [
    "description",
    "loss_percent"
  ]
}