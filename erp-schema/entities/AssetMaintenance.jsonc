{
  "name": "AssetMaintenance",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "ID do ativo"
    },
    "asset_name": {
      "type": "string",
      "description": "Nome do ativo"
    },
    "type": {
      "type": "string",
      "enum": [
        "preventiva",
        "corretiva",
        "substituicao",
        "calibracao"
      ],
      "description": "Tipo de manuten\u00e7\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta",
        "urgente"
      ],
      "default": "normal",
      "description": "Prioridade"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "cost": {
      "type": "number",
      "description": "Custo"
    },
    "technician": {
      "type": "string",
      "description": "T\u00e9cnico respons\u00e1vel"
    },
    "replaced_parts": {
      "type": "string",
      "description": "Pe\u00e7as substitu\u00eddas"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Data agendada"
    },
    "next_maintenance": {
      "type": "string",
      "format": "date",
      "description": "Pr\u00f3xima manuten\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status"
    }
  },
  "required": [
    "asset_id",
    "type"
  ]
}